/* Reset & base */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    background-color: #fff0f5; /* soft pink */
    color: #333;
    line-height: 1.6;
}

/* Header */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2rem;
    background-color: #ffe4e1;
}

header h1 {
    font-weight: 600;
    color: #ff69b4;
}

nav a {
    margin-left: 1rem;
    text-decoration: none;
    color: #ff1493;
    font-weight: 500;
}

nav a:hover {
    text-decoration: underline;
}

/* Hero section */
.hero {
    text-align: center;
    padding: 4rem 2rem;
    background-color: #fff0f5;
}

.hero h2 {
    font-size: 2.5rem;
    color: #ff69b4;
    margin-bottom: 1rem;
}

.hero p {
    margin-bottom: 2rem;
    font-size: 1.2rem;
}

.btn {
    padding: 0.8rem 2rem;
    background-color: #ff69b4;
    color: white;
    text-decoration: none;
    border-radius: 25px;
    font-weight: 600;
}

.btn:hover {
    background-color: #ff1493;
}

/* Collections */
.collections {
    padding: 4rem 2rem;
    text-align: center;
}

.cards {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 2rem;
}

.card {
    background: #fff;
    border-radius: 15px;
    overflow: hidden;
    width: 250px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
}

.card img {
    width: 100%;
    display: block;
}

.card h3 {
    padding: 1rem;
    color: #ff69b4;
}

/* About & Contact */
.about, .contact {
    padding: 4rem 2rem;
    text-align: center;
}

/* Footer */
footer {
    text-align: center;
    padding: 2rem;
    background-color: #ffe4e1;
    color: #ff1493;
}
